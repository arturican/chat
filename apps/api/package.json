{
  "name": "@pulsechat/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/pulsechat} JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET:-change-me-access-secret} JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-change-me-refresh-secret} ACCESS_TOKEN_TTL=${ACCESS_TOKEN_TTL:-15m} REFRESH_TOKEN_TTL=${REFRESH_TOKEN_TTL:-30d} S3_ENDPOINT=${S3_ENDPOINT:-http://localhost:9000} S3_REGION=${S3_REGION:-us-east-1} S3_BUCKET=${S3_BUCKET:-pulsechat} S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID:-minioadmin} S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY:-minioadmin} APP_ORIGIN=${APP_ORIGIN:-http://localhost:3000} API_PORT=${API_PORT:-4000} jest --config ./jest.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/platform-ws": "^11.1.17",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/client": "^6.19.2",
    "@pulsechat/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  }
}
