generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile      Profile?
  sessions     Session[]
  createdChats Chat[]       @relation("ChatCreator")
  chatMembers  ChatMember[]
  messages     Message[]

  @@map("users")
}

model Profile {
  userId      String    @id @map("user_id") @db.Uuid
  username    String    @unique
  displayName String?   @map("display_name")
  bio         String?
  avatarKey   String?   @map("avatar_key")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model Chat {
  id          String       @id @default(uuid()) @db.Uuid
  type        ChatType
  title       String?
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   User         @relation("ChatCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     ChatMember[]
  messages    Message[]

  @@index([type], map: "chats_type_idx")
  @@index([updatedAt], map: "chats_updated_at_idx")
  @@map("chats")
}

model ChatMember {
  chatId   String         @map("chat_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     ChatMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at") @db.Timestamptz(3)
  chat     Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId, joinedAt], map: "chat_members_user_joined_idx")
  @@index([chatId, role], map: "chat_members_chat_role_idx")
  @@map("chat_members")
}

model Message {
  id               String    @id @default(uuid()) @db.Uuid
  chatId           String    @map("chat_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  body             String
  replyToMessageId String?   @map("reply_to_message_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  chat             Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author           User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo          Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReplies")

  @@index([chatId, createdAt], map: "messages_chat_created_idx")
  @@index([authorId, createdAt], map: "messages_author_created_idx")
  @@index([replyToMessageId], map: "messages_reply_to_idx")
  @@map("messages")
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  OWNER
  MEMBER
}
